ReaverEffect: {
	DisplayName: Адаптивность расхитителя
	Tooltip:
		'''
		Переключает между покрытым и облегчённым режимами
		Покрытый: Увеличивает защиту на 10, получение урона даёт бафф «Ярость расхитителя»
		Облегчённый: Ускоряет регенерацию здоровья на 4 ОЗ/сек, увеличивает скорость и время полёта на 10%,
		увеличивает частоту использования рывка и скорость крюков-кошек
		'''
}

UmbraphileEffect: {
	DisplayName: Трансформация в стаю летучих мышей
	Tooltip:
		'''
		Ненадолго превращает вас в стаю летучих мышей
		Пока вы находитесь в этой форме, вы получаете неуязвимость, бесконечный полёт и +30% к скорости передвижения
		Стая летучих мышей наносит врагам урон и похищает здоровье
		'''
}

ElementsForceEffect: {
	DisplayName: Элементальный сдвиг
	Tooltip: Переключает между режимами магмы и метели
}
